    {
      "parameters": {
        "jsCode": "// ════════════════════════════════════════════════════════════════\n// VITRINE — Node unico: extrai venda + busca UTMs no Supabase\n// ════════════════════════════════════════════════════════════════\n\n// 1. Recebe payload da Hotmart\nconst payload = $input.first().json;\nconst event = payload.event;\nconst data = payload.data || payload;\n\n// 2. Extrai click_id (vem da Hotmart como \"source\" se voce passou via UTM)\nconst clickId = data.purchase?.source\n  || data.source\n  || data.purchase?.tracking?.source\n  || null;\n\n// 3. Monta objeto base da venda\nconst venda = {\n  data: data.purchase?.approved_at || new Date().toISOString(),\n  transaction_id: data.purchase?.transaction || data.id || '',\n  product_id: data.product?.id || '',\n  product_name: data.product?.name || '',\n  value_brl: parseFloat(data.purchase?.price?.value || 0),\n  buyer_name: data.buyer?.name || '',\n  buyer_email: data.buyer?.email || '',\n  click_id: clickId || '',\n  event: event || '',\n};\n\n// 4. UTMs default (direct)\nlet utms = {\n  utm_source: 'direct',\n  utm_medium: '',\n  utm_campaign: '',\n  utm_content: '',\n  utm_term: '',\n};\n\n// 5. Se tem click_id valido, busca UTMs no Supabase\nif (clickId && clickId.length > 0) {\n  try {\n    const response = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `https://fbeofenkrvmqdlmgjfna.supabase.co/rest/v1/clicks?click_id=eq.${clickId}&select=utm_source,utm_medium,utm_campaign,utm_content,utm_term`,\n      headers: {\n        apikey: 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZiZW9mZW5rcnZtcWRsbWdqZm5hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA2Mzk3NzIsImV4cCI6MjEwNjIxNTc3Mn0.fHBBbNAM4BUpBoS2-mvxmlgFFe9XCXk7w0DmnfJT2jg',\n        Authorization: 'Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZiZW9mZW5rcnZtcWRsbWdqZm5hIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA2Mzk3NzIsImV4cCI6MjEwNjIxNTc3Mn0.fHBBbNAM4BUpBoS2-mvxmlgFFe9XCXk7w0DmnfJT2jg',\n      },\n      timeout: 10000,\n    });\n    \n    if (Array.isArray(response) && response.length > 0) {\n      utms = {\n        utm_source: response[0].utm_source || 'direct',\n        utm_medium: response[0].utm_medium || '',\n        utm_campaign: response[0].utm_campaign || '',\n        utm_content: response[0].utm_content || '',\n        utm_term: response[0].utm_term || '',\n      };\n    }\n  } catch (e) {\n    // Se Supabase falhar, continua com 'direct' — workflow NAO para\n    console.log('Supabase lookup failed:', e.message);\n  }\n}\n\n// 6. Combina venda + UTMs e devolve pro Google Sheets\nreturn [{\n  json: {\n    ...venda,\n    ...utms,\n  }\n}];"
      },
