# ════════════════════════════════════════════════════════════════
# MEGAZORD MVP — Variaveis de ambiente
# Copie para .env e preencha. NUNCA commit o .env real.
# ════════════════════════════════════════════════════════════════

# ── Nomes dos filhotes ──
F1_ENCAMINHADOR_NAME=encaminhador
F2_VITRINE_NAME=vitrine
F3_STORYMETRO_NAME=storymetro
F4_SUSSURROS_NAME=sussurros
F5_SINTETIZADOR_NAME=sintetizador

# ── Supabase (pegar em: Supabase Dashboard > Project Settings > API) ──
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=cole-sua-anon-key-aqui
SUPABASE_SERVICE_KEY=cole-sua-service-role-key-aqui

# ── GLM (z.ai) ──
GLM_API_KEY=cole-seu-glm-api-key
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# ── ManyChat ──
MANYCHAT_TOKEN=cole-seu-manychat-token
MANYCHAT_TEMPLATE_ID=cole-id-do-template

# ── Hotmart ──
HOTMART_WEBHOOK_SECRET=cole-seu-webhook-secret

# ── Instagram Graph API ──
IG_USER_ID=cole-seu-ig-user-id
IG_ACCESS_TOKEN=cole-seu-ig-access-token

# ── Google Sheets ──
SHEETS_ID=cole-id-da-planilha
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json

# ── Cloudflare (Wrangler) ──
# NAO coloque tokens aqui. Use variaveis de ambiente do shell:
#   export CLOUDFLARE_API_TOKEN=...
#   export CLOUDFLARE_ACCOUNT_ID=...
# Token em: dash.cloudflare.com > Profile > API Tokens
# Account ID em: dash.cloudflare.com > Account Home (canto direito)
SHORT_DOMAIN=https://encaminhador.SUA-CONTA.workers.dev

# ── n8n (local, opcional) ──
N8N_WEBHOOK_URL=http://localhost:5678/webhook
